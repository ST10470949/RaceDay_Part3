@model EventFormViewModel
@{
    ViewData["Title"] = "Edit Event";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="rd-form-card">
            <h1 class="rd-heading mb-1">Edit event</h1>
            <p class="text-muted mb-4">Update the details below.</p>

            <form asp-controller="Organiser" asp-action="EditEvent" asp-route-id="@Model.EventID" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                @await Html.PartialAsync("_EventFormFields", Model)
                <button type="submit" class="btn btn-rd-primary">Save changes</button>
                <a class="btn btn-rd-outline-dark" asp-controller="Organiser" asp-action="Events">Cancel</a>
            </form>
        </div>
    </div>
</div>
