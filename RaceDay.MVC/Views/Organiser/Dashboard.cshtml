@model OrganiserDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="rd-heading mb-1">Welcome back@(!string.IsNullOrEmpty(ViewBag.OrganiserName as string) ? $", {ViewBag.OrganiserName}" : "")</h1>
        <p class="text-muted mb-0">Here's how your events are shaping up.</p>
    </div>
    <a class="btn btn-rd-primary" asp-controller="Organiser" asp-action="CreateEvent"><i class="bi bi-plus-lg"></i> New event</a>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger rd-alert">@ViewBag.ErrorMessage</div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4">
        <div class="rd-stat">
            <div class="rd-stat-value">@Model.TotalEvents</div>
            <div class="rd-stat-label">Events created</div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="rd-stat">
            <div class="rd-stat-value">@Model.TotalEnrolments</div>
            <div class="rd-stat-label">Total enrolments</div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="rd-stat">
            <div class="rd-stat-value">@Model.Events.Count(e => e.EventDate >= DateTime.Today)</div>
            <div class="rd-stat-label">Upcoming events</div>
        </div>
    </div>
</div>

<h4 class="rd-heading mb-3">Your events</h4>

@if (!Model.Events.Any())
{
    <div class="rd-form-card text-center text-muted py-5">
        <i class="bi bi-flag display-4 d-block mb-3"></i>
        You haven't created any events yet.
        <div class="mt-3">
            <a class="btn btn-rd-primary" asp-controller="Organiser" asp-action="CreateEvent">Create your first event</a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var ev in Model.Events)
        {
            <div class="col-md-6 col-lg-4">
                <div class="rd-card">
                    @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
                    {
                        <img src="@ev.BannerImageUrl" class="rd-card-banner" alt="@ev.Name" />
                    }
                    else
                    {
                        <div class="rd-card-banner-placeholder"><i class="bi bi-image"></i></div>
                    }
                    <div class="rd-card-body">
                        <h5 class="rd-heading mb-1">@ev.Name</h5>
                        <p class="text-muted mb-1"><i class="bi bi-geo-alt"></i> @ev.Location</p>
                        <p class="text-muted mb-2"><i class="bi bi-calendar-event"></i> @ev.EventDate.ToString("dd MMM yyyy")</p>
                        <span class="rd-badge rd-badge-confirmed">@ev.EnrolmentCount enrolled</span>
                        <div class="d-flex gap-2 mt-3">
                            <a class="btn btn-rd-dark btn-sm flex-fill" asp-controller="Organiser" asp-action="Enrolments" asp-route-eventId="@ev.EventID">Enrolments</a>
                            <a class="btn btn-rd-outline-dark btn-sm flex-fill" asp-controller="Organiser" asp-action="EditEvent" asp-route-id="@ev.EventID">Edit</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
