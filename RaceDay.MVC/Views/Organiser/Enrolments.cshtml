@model List<EnrolmentViewModel>
@{
    ViewData["Title"] = "Enrolments";
}

<div class="mb-4">
    <a class="text-muted small" asp-controller="Organiser" asp-action="Events"><i class="bi bi-arrow-left"></i> Back to my events</a>
    <h1 class="rd-heading mt-2 mb-0">Enrolments for @ViewBag.EventName</h1>
    <p class="text-muted">@Model.Count enrolled so far</p>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger rd-alert">@ViewBag.ErrorMessage</div>
}

@if (!Model.Any())
{
    <div class="rd-form-card text-center text-muted py-5">
        <i class="bi bi-people display-4 d-block mb-3"></i>
        Nobody has enrolled for this event yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table rd-table align-middle">
            <thead>
                <tr>
                    <th>Participant</th>
                    <th>Category</th>
                    <th>Enrolled on</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var enrolment in Model)
                {
                    <tr>
                        <td class="fw-semibold">@enrolment.ParticipantName</td>
                        <td>@enrolment.CategoryName</td>
                        <td>@enrolment.EnrolmentDate.ToString("dd MMM yyyy")</td>
                        <td>
                            @{
                                var badgeClass = enrolment.Status.ToLower() switch
                                {
                                    "confirmed" => "rd-badge-confirmed",
                                    "pending" => "rd-badge-pending",
                                    _ => "rd-badge-cancelled"
                                };
                            }
                            <span class="rd-badge @badgeClass">@enrolment.Status</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
