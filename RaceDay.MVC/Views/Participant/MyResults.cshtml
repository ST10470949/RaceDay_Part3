@model List<ResultViewModel>
@{
    ViewData["Title"] = "My Results";
}

<h1 class="rd-heading mb-1">My Results</h1>
<p class="text-muted mb-4">Your race history across every event you've completed.</p>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger rd-alert">@ViewBag.ErrorMessage</div>
}

@if (!Model.Any())
{
    <div class="rd-form-card text-center text-muted py-5">
        <i class="bi bi-trophy display-4 d-block mb-3"></i>
        No results yet - they'll show up here once an Organiser publishes them after an event.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table rd-table align-middle">
            <thead>
                <tr>
                    <th>Event</th>
                    <th>Date</th>
                    <th>Category</th>
                    <th>Finish time</th>
                    <th>Position</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var result in Model.OrderByDescending(r => r.EventDate))
                {
                    <tr>
                        <td class="fw-semibold">@result.EventName</td>
                        <td>@result.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@result.CategoryName</td>
                        <td>@(result.FinishTime?.ToString(@"hh\:mm\:ss") ?? "Not yet published")</td>
                        <td>@result.PositionDisplay</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
