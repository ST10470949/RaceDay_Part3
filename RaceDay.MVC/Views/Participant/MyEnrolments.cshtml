@model List<EnrolmentViewModel>
@{
    ViewData["Title"] = "My Enrolments";
}

<h1 class="rd-heading mb-1">My Enrolments</h1>
<p class="text-muted mb-4">Every event you've entered, in one place.</p>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger rd-alert">@ViewBag.ErrorMessage</div>
}

@if (!Model.Any())
{
    <div class="rd-form-card text-center text-muted py-5">
        <i class="bi bi-flag display-4 d-block mb-3"></i>
        You haven't entered any events yet.
        <div class="mt-3">
            <a class="btn btn-rd-primary" asp-controller="Home" asp-action="Index">Browse events</a>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var enrolment in Model)
        {
            <div class="col-md-6">
                <div class="rd-form-card d-flex justify-content-between align-items-start">
                    <div>
                        <h5 class="rd-heading mb-1">@enrolment.EventName</h5>
                        <p class="text-muted mb-1">@enrolment.CategoryName</p>
                        <p class="text-muted small mb-2">Entered @enrolment.EnrolmentDate.ToString("dd MMM yyyy")</p>
                        @{
                            var badgeClass = enrolment.Status.ToLower() switch
                            {
                                "confirmed" => "rd-badge-confirmed",
                                "pending" => "rd-badge-pending",
                                _ => "rd-badge-cancelled"
                            };
                        }
                        <span class="rd-badge @badgeClass">@enrolment.Status</span>
                    </div>
                    <div class="d-flex flex-column gap-2">
                        <a class="btn btn-rd-outline-dark btn-sm" asp-controller="Home" asp-action="Details" asp-route-id="@enrolment.EventID">View event</a>
                        <form asp-controller="Participant" asp-action="CancelEnrolment" method="post"
                              onsubmit="return confirm('Cancel your entry for @enrolment.EventName?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="enrolmentId" value="@enrolment.EnrolmentID" />
                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">Cancel</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
